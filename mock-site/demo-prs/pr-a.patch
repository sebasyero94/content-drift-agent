From 501dd7bada34aac476d0427dd0189fee9c9543bb Mon Sep 17 00:00:00 2001
From: Sebastian Yerovi <sebasyero94@gmail.com>
Date: Sat, 3 Oct 2026 13:26:55 -0700
Subject: [PATCH] Raise Free plan limits: 20K session replays, 20 active
 feature flags

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 mock-site/index.html | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/mock-site/index.html b/mock-site/index.html
index de3db42..76b1964 100644
--- a/mock-site/index.html
+++ b/mock-site/index.html
@@ -33,9 +33,9 @@
     <ul>
       <li>Unlimited seats</li>
       <li>Up to 1M events / month</li>
-      <li>10K session replays / month</li>
+      <li>20K session replays / month</li>
       <li>Up to 1k MEU / month for experiments</li>
-      <li>Up to 10 active feature flags</li>
+      <li>Up to 20 active feature flags</li>
     </ul>
   </div>
   <div class="plan" id="plan-growth">
@@ -65,9 +65,9 @@
   <table>
     <tr><th>Usage</th><th>Free</th><th>Growth</th><th>Enterprise</th></tr>
     <tr><td>Monthly events</td><td>Up to 1M</td><td>Up to 20M</td><td>Up to 1T</td></tr>
-    <tr><td>Session replays</td><td>10K monthly sessions</td><td>Up to 500K monthly sessions</td><td>Custom</td></tr>
+    <tr><td>Session replays</td><td>20K monthly sessions</td><td>Up to 500K monthly sessions</td><td>Custom</td></tr>
     <tr><td>Experiments</td><td>1k MEU / month</td><td>Up to 100k MEU / month</td><td>Custom</td></tr>
-    <tr><td>Active feature flags</td><td>Up to 10</td><td>Up to 50</td><td>Custom</td></tr>
+    <tr><td>Active feature flags</td><td>Up to 20</td><td>Up to 50</td><td>Custom</td></tr>
   </table>
 </section>
 
@@ -82,7 +82,7 @@
 <section id="faq">
   <h2>Frequently asked questions</h2>
   <details><summary>What does the Free plan include?</summary>
-    <p>Up to 1M events a month, 10K session replays a month, and up to 10 active feature flags.</p></details>
+    <p>Up to 1M events a month, 20K session replays a month, and up to 20 active feature flags.</p></details>
   <details><summary>How long are session replays stored?</summary>
     <p>Replays are kept for 30 days by default. Enterprise plans can customize the retention period.</p></details>
   <details><summary>Do you offer startup discounts?</summary>
